# --- Generated by SETUP.cmd -------------------------------------------------
# Cmder is not part of the source tree. It ships as lib/cmder-<version>.zip and
# is unpacked here at setup time, so `git status` stays clean in a checkout and
# updating Cmder is a new archive plus a digest rather than a diff over a
# vendored tree.
Cmder.exe
# Cmder's version marker, e.g. "Version 1.3.24.236". Anchored so it cannot be
# confused with the VERSION file at the repo root, which IS tracked.
/Version *
DOWNLOAD LATEST VERSION (cmder).url
vendor/
config/
opt/
icons/

# --- Generated by install.cmd ----------------------------------------------
# nvm-windows version store and its "current version" link.
nodejs/
node/
# Written by install.cmd. It must sit next to bin\nvm.exe, because that is
# where nvm-windows looks for it, which unfortunately puts a generated file
# inside a tracked directory. Keeping it ignored is what lets an install in a
# checkout leave `git status` clean.
bin/settings.txt

# --- Linux OOBE artifacts (generated by oobe.sh) --------------------------
# nvm-sh and the Node.js versions it manages.
.nvm/
# Download cache for the nvm-sh archive.
.oobe-cache/

# --- Editor / OS noise ----------------------------------------------------
*.swp
.DS_Store
Thumbs.db

# --- Release artifacts (see pack.cmd) -----------------------------------
cmder-nvm.zip
cmder-nvm-v*.zip
